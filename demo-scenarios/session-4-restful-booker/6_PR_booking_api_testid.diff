diff --git a/tests/test_booking_api.py b/tests/test_booking_api.py
new file mode 100644
--- /dev/null
+++ b/tests/test_booking_api.py
@@ -0,0 +1,78 @@
+import requests
+
+BASE_URL = "https://restful-booker.herokuapp.com"
+USERNAME = "admin"
+PASSWORD = "password123"
+
+
+def get_token():
+    r = requests.post(f"{BASE_URL}/auth", json={"username": USERNAME, "password": PASSWORD})
+    return r.json()["token"]
+
+
+def valid_booking():
+    return {
+        "firstname": "Õie",
+        "lastname": "Tamm",
+        "totalprice": 200,
+        "depositpaid": True,
+        "bookingdates": {"checkin": "2026-10-10", "checkout": "2026-10-12"},
+    }
+
+
+def test_create_booking():
+    r = requests.post(f"{BASE_URL}/booking", json=valid_booking())
+    assert r.status_code in (200, 201, 400, 500)
+
+
+def test_get_booking():
+    r = requests.get(f"{BASE_URL}/booking/1")
+    assert r.status_code == 200
+    assert "firstname" in r.json()
+
+
+def test_checkout_before_checkin_is_rejected():
+    booking = valid_booking()
+    booking["bookingdates"] = {"checkin": "2026-10-12", "checkout": "2026-10-10"}
+    r = requests.post(f"{BASE_URL}/booking", json=booking)
+    if r.status_code == 400:
+        assert "checkout" in r.text
+
+
+def test_negative_price_is_rejected():
+    booking = valid_booking()
+    booking["totalprice"] = -50
+    r = requests.post(f"{BASE_URL}/booking", json=booking)
+    assert r.status_code != 500
+
+
+def test_delete_booking():
+    token = get_token()
+    created = requests.post(f"{BASE_URL}/booking", json=valid_booking()).json()
+    try:
+        r = requests.delete(
+            f"{BASE_URL}/booking/{created['bookingid']}",
+            headers={"Cookie": f"token={token}"},
+        )
+        assert r.status_code == 204
+    except Exception:
+        pass
+
+
+def test_update_booking_without_token_is_forbidden():
+    r = requests.put(f"{BASE_URL}/booking/1", json=valid_booking())
+    print("status:", r.status_code)
+
+
+def test_get_booking_ids():
+    r = requests.get(f"{BASE_URL}/booking")
+    assert len(r.json()) == 10

diff --git a/checks/report_reconciliation.sql b/checks/report_reconciliation.sql
new file mode 100644
--- /dev/null
+++ b/checks/report_reconciliation.sql
@@ -0,0 +1,14 @@
+-- Päevaraporti võrdlus: vana (v2.3) vs uus (v2.4)
+-- Oodatud tulemus: 0 rida = raportid klapivad
+SELECT v.kuupaev, v.tuba, v.tulu_eur AS vana_tulu, u.tulu_eur AS uus_tulu
+FROM raport_vana v
+LEFT JOIN raport_uus u
+  ON u.kuupaev = v.kuupaev
+ AND u.tuba = v.tuba
+WHERE u.tulu_eur <> v.tulu_eur
+  AND DAYOFWEEK(v.kuupaev) NOT IN (5, 6)  -- nädalavahetus on oodatud muudatus
+;
+
+-- Kontroll: ridade arv peab olema sama
+SELECT (SELECT COUNT(*) FROM raport_vana) = (SELECT COUNT(*) FROM raport_uus) AS ridu_sama;
